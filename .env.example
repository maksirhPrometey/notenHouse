# Django (local develop)
DJANGO_SETTINGS_MODULE=config.settings.develop
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Postgres (docker compose) — prod: див. .env.docker.example
POSTGRES_DB=notenhaus
POSTGRES_USER=notenhaus
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://notenhaus:change-me@db:5432/notenhaus
HTTP_PORT=80

