# DigitalOcean Droplet production (.env на сервері, НЕ комітити)
# cp .env.docker.example .env && nano .env
#
# Droplet IP: 139.59.135.20
# Certbot email (placeholder до реального домену): notenhouse-le-7f2a9c@example.com

DJANGO_SETTINGS_MODULE=config.settings.docker
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DEBUG=False

# До SSL / домену — false; після certbot — true
USE_HTTPS=false
SITE_URL=http://139.59.135.20
SECURE_SSL_REDIRECT=False

POSTGRES_DB=notenhaus
POSTGRES_USER=notenhaus
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://notenhaus:change-me-strong-password@db:5432/notenhaus

# IP Droplet + internal compose DNS (web) + localhost для healthcheck
ALLOWED_HOSTS=139.59.135.20,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=http://139.59.135.20

HTTP_PORT=80

# Integrations (placeholders)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NotenHaus <noreply@example.com>

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

NP_API_KEY=
