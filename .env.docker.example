# DigitalOcean Droplet production (.env на сервері, НЕ комітити)
# cp .env.docker.example .env && nano .env
#
# Droplet IP: 46.101.195.90
# Domain: notenhaus.com.ua
# Certbot: -m admin@notenhaus.com.ua

DJANGO_SETTINGS_MODULE=config.settings.docker
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DEBUG=False

# До certbot — false; після SSL — true
USE_HTTPS=false
SITE_URL=https://notenhaus.com.ua
SECURE_SSL_REDIRECT=False

POSTGRES_DB=notenhaus
POSTGRES_USER=notenhaus
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://notenhaus:change-me-strong-password@db:5432/notenhaus

# Домен, IP Droplet, web (internal healthcheck), localhost
ALLOWED_HOSTS=notenhaus.com.ua,www.notenhaus.com.ua,46.101.195.90,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=https://notenhaus.com.ua,https://www.notenhaus.com.ua

HTTP_PORT=80

# Integrations (placeholders)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NotenHaus <noreply@notenhaus.com.ua>

LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

NP_API_KEY=
